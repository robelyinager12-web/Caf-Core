NODE_ENV=development
PORT=5000

DATABASE_URL="postgresql://postgres:1234@localhost:5432/CaféCore_db?schema=public"
# Neon: use the pooled (-pooler) URL for DATABASE_URL and the direct URL for migrations.
DATABASE_URL_UNPOOLED="postgresql://postgres:1234@localhost:5432/CaféCore_db?schema=public"

# Generate strong secrets with: openssl rand -base64 48
# Never reuse the same value for both — a leaked access secret should not
# also compromise the ability to mint new long-lived refresh tokens.
JWT_ACCESS_SECRET=77491ec15c3b960936ac15d5f3e09aaa8fda40e177b98e612610c1bb6fc152af9abbdaac92eef1d08a6cb77ec3fa0c362d9aec9863c77a9fda79d6005c0d6be7
JWT_REFRESH_SECRET=fc50e77f38df7ddf518b37a3990e4dc2c7980460cbe2f1255e32c5fd4e479992b092b6a791f4f897b8637b92ff4dc9862ddab83430453743997aa2c91c239400
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

UPLOAD_DIR=uploads/menu-images
MAX_UPLOAD_SIZE_MB=5