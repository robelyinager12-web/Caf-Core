NODE_ENV=development
PORT=5000

DATABASE_URL="postgresql://postgres:1234@localhost:5432/CaféCore_db?schema=public"

# Generate strong secrets with: openssl rand -base64 48
# Never reuse the same value for both — a leaked access secret should not
# also compromise the ability to mint new long-lived refresh tokens.
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

UPLOAD_DIR=uploads/menu-images
MAX_UPLOAD_SIZE_MB=5