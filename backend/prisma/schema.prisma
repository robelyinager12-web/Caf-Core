generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(uuid())
  fullName      String       @map("full_name") @db.VarChar(150)
  email         String       @unique @db.VarChar(150)
  passwordHash  String       @map("password_hash") @db.VarChar(255)
  role          Role         @default(CASHIER)
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  auditLogs     AuditLog[]
  ordersCreated Order[]      @relation("OrderCreatedBy")
  payments      Payment[]    @relation("PaymentProcessedBy")
  shifts        StaffShift[]

  @@map("users")
}

model Category {
  id           String     @id @default(uuid())
  name         String     @unique @db.VarChar(100)
  displayOrder Int        @default(0) @map("display_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  menuItems    MenuItem[]

  @@map("categories")
}

model MenuItem {
  id          String      @id @default(uuid())
  categoryId  String      @map("category_id")
  name        String      @db.VarChar(150)
  description String?
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String?     @map("image_url") @db.VarChar(255)
  isAvailable Boolean     @default(true) @map("is_available")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  recipes     Recipe[]

  @@index([categoryId], map: "idx_menu_items_category")
  @@index([isAvailable], map: "idx_menu_items_available")
  @@map("menu_items")
}

model Ingredient {
  id        String     @id @default(uuid())
  name      String     @unique @db.VarChar(150)
  unit      String     @db.VarChar(20)
  createdAt DateTime   @default(now()) @map("created_at")
  inventory Inventory?
  recipes   Recipe[]

  @@map("ingredients")
}

model Inventory {
  id                String     @id @default(uuid())
  ingredientId      String     @unique @map("ingredient_id")
  quantityInStock   Decimal    @default(0) @map("quantity_in_stock") @db.Decimal(10, 2)
  lowStockThreshold Decimal    @default(10) @map("low_stock_threshold") @db.Decimal(10, 2)
  updatedAt         DateTime   @updatedAt @map("updated_at")
  ingredient        Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([ingredientId], map: "idx_inventory_ingredient")
  @@map("inventory")
}

model Recipe {
  id               String     @id @default(uuid())
  menuItemId       String     @map("menu_item_id")
  ingredientId     String     @map("ingredient_id")
  quantityRequired Decimal    @map("quantity_required") @db.Decimal(10, 2)
  ingredient       Ingredient @relation(fields: [ingredientId], references: [id])
  menuItem         MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, ingredientId], name: "uq_recipe_item_ingredient")
  @@index([menuItemId], map: "idx_recipes_menu_item")
  @@map("recipes")
}

model Order {
  id           String      @id @default(uuid())
  orderNumber  String      @unique @map("order_number") @db.VarChar(20)
  createdById  String?     @map("created_by")
  guestName    String?     @map("guest_name") @db.VarChar(150)
  guestPhone   String?     @map("guest_phone") @db.VarChar(30)
  status       OrderStatus @default(PENDING)
  orderType    OrderType   @default(TAKEAWAY) @map("order_type")
  tableOrToken String?     @map("table_or_token") @db.VarChar(20)
  subtotal     Decimal     @db.Decimal(10, 2)
  total        Decimal     @db.Decimal(10, 2)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  items        OrderItem[]
  createdBy    User?       @relation("OrderCreatedBy", fields: [createdById], references: [id])
  payment      Payment?

  @@index([status], map: "idx_orders_status")
  @@index([createdAt], map: "idx_orders_created_at")
  @@index([status, createdAt], map: "idx_orders_status_created_at")
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  menuItemId String   @map("menu_item_id")
  quantity   Int
  unitPrice  Decimal  @map("unit_price") @db.Decimal(10, 2)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "idx_order_items_order")
  @@map("order_items")
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @unique @map("order_id")
  method        PaymentMethod
  amount        Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(PENDING)
  processedById String        @map("processed_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  order         Order         @relation(fields: [orderId], references: [id])
  processedBy   User          @relation("PaymentProcessedBy", fields: [processedById], references: [id])

  @@map("payments")
}

model StaffShift {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  shiftStart DateTime  @map("shift_start")
  shiftEnd   DateTime? @map("shift_end")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_shifts_user")
  @@map("staff_shifts")
}

model Notification {
  id         String           @id @default(uuid())
  type       NotificationType
  message    String
  isRead     Boolean          @default(false) @map("is_read")
  targetRole Role?            @map("target_role")
  createdAt  DateTime         @default(now()) @map("created_at")

  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id])

  @@index([createdAt], map: "idx_audit_created_at")
  @@index([action], map: "idx_audit_action")
  @@map("audit_logs")
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
  KITCHEN
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum NotificationType {
  LOW_STOCK
  NEW_ORDER
  SYSTEM
}
