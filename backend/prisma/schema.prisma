// Added to the existing MenuItem model:
model MenuItem {
  // ...existing fields unchanged...

  @@index([categoryId], name: "idx_menu_items_category")
  @@index([isAvailable], name: "idx_menu_items_available")
  @@map("menu_items")
}

// Added to the existing Order model:
model Order {
  // ...existing fields unchanged...

  @@index([status], name: "idx_orders_status")
  @@index([createdAt], name: "idx_orders_created_at")
  @@index([status, createdAt], name: "idx_orders_status_created_at")
  @@map("orders")
}

// Added to the existing AuditLog model:
model AuditLog {
  // ...existing fields unchanged...

  @@index([createdAt], name: "idx_audit_created_at")
  @@index([action], name: "idx_audit_action")
  @@map("audit_logs")
}