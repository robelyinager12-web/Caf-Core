generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
  KITCHEN
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum NotificationType {
  LOW_STOCK
  NEW_ORDER
  SYSTEM
}

model User {
  id           String   @id @default(uuid())
  fullName     String   @map("full_name") @db.VarChar(150)
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(CASHIER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ordersCreated Order[]        @relation("OrderCreatedBy")
  payments      Payment[]      @relation("PaymentProcessedBy")
  shifts        StaffShift[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Category {
  id            String     @id @default(uuid())
  name          String     @unique @db.VarChar(100)
  displayOrder  Int        @default(0) @map("display_order")
  createdAt     DateTime   @default(now()) @map("created_at")

  menuItems     MenuItem[]

  @@map("categories")
}

model MenuItem {
  id           String   @id @default(uuid())
  categoryId   String   @map("category_id")
  name         String   @db.VarChar(150)
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  imageUrl     String?  @map("image_url") @db.VarChar(255)
  isAvailable  Boolean  @default(true) @map("is_available")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  category     Category      @relation(fields: [categoryId], references: [id])
  recipes      Recipe[]
  orderItems   OrderItem[]

  @@index([categoryId], name: "idx_menu_items_category")
  @@map("menu_items")
}

model Ingredient {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(150)
  unit      String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  inventory Inventory?
  recipes   Recipe[]

  @@map("ingredients")
}

model Inventory {
  id                 String   @id @default(uuid())
  ingredientId       String   @unique @map("ingredient_id")
  quantityInStock    Decimal  @default(0) @map("quantity_in_stock") @db.Decimal(10, 2)
  lowStockThreshold  Decimal  @default(10) @map("low_stock_threshold") @db.Decimal(10, 2)
  updatedAt          DateTime @updatedAt @map("updated_at")

  ingredient         Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([ingredientId], name: "idx_inventory_ingredient")
  @@map("inventory")
}

model Recipe {
  id                String  @id @default(uuid())
  menuItemId        String  @map("menu_item_id")
  ingredientId      String  @map("ingredient_id")
  quantityRequired  Decimal @map("quantity_required") @db.Decimal(10, 2)

  menuItem          MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient        Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([menuItemId, ingredientId], name: "uq_recipe_item_ingredient")
  @@index([menuItemId], name: "idx_recipes_menu_item")
  @@map("recipes")
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique @map("order_number") @db.VarChar(20)
  createdById   String      @map("created_by")
  status        OrderStatus @default(PENDING)
  orderType     OrderType   @default(TAKEAWAY) @map("order_type")
  tableOrToken  String?     @map("table_or_token") @db.VarChar(20)
  subtotal      Decimal     @db.Decimal(10, 2)
  total         Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  createdBy     User        @relation("OrderCreatedBy", fields: [createdById], references: [id])
  items         OrderItem[]
  payment       Payment?

  @@index([status], name: "idx_orders_status")
  @@index([createdAt], name: "idx_orders_created_at")
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String  @map("order_id")
  menuItemId  String  @map("menu_item_id")
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId], name: "idx_order_items_order")
  @@map("order_items")
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @unique @map("order_id")
  method        PaymentMethod
  amount        Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(PENDING)
  processedById String        @map("processed_by")
  createdAt     DateTime      @default(now()) @map("created_at")

  order         Order @relation(fields: [orderId], references: [id])
  processedBy   User  @relation("PaymentProcessedBy", fields: [processedById], references: [id])

  @@map("payments")
}

model StaffShift {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  shiftStart  DateTime  @map("shift_start")
  shiftEnd    DateTime? @map("shift_end")
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User @relation(fields: [userId], references: [id])

  @@index([userId], name: "idx_shifts_user")
  @@map("staff_shifts")
}

model Notification {
  id         String           @id @default(uuid())
  type       NotificationType
  message    String
  isRead     Boolean          @default(false) @map("is_read")
  targetRole Role?            @map("target_role")
  createdAt  DateTime         @default(now()) @map("created_at")

  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user       User? @relation(fields: [userId], references: [id])

  @@index([createdAt], name: "idx_audit_created_at")
  @@map("audit_logs")
}